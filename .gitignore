/target
# The rescued oracles under tools/ are standalone crates with their own build dirs.
tools/**/target/
**/*.rs.bk
*.pdb

# Local machine state
.DS_Store
/.vscode
/.idea
# xwin defaults --cache-dir to ./.xwin-cache; scripts/check-windows.sh documents
# --temp instead. This is the backstop for a bare xwin run in the repo root.
/.xwin-cache/
# Per-machine agent permissions — absolute paths, meaningless on another box.
# A shared .claude/settings.json would be committed; the .local.json never is.
/.claude/settings.local.json

# Never commit connection credentials or captured session data
/favourites.local.toml
*.rdpcap
/bench-out/
